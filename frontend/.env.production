# Production build talks to the API same-origin via the Vercel proxy in
# vercel.json, which rewrites /api/* to the backend on Render
# (api.jobcraft.ahmadsheraz.com). Keeping this relative means the browser treats
# every API request as same-origin, so the auth cookie is always sent.
#
# NOTE: the Vercel project also sets VITE_API_URL=/api as a build-time env var,
# which overrides this file. They are kept in sync here so a local production
# build matches the deployed one.
VITE_API_URL=/api
