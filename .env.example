# MongoDB Config
MONGO_URI=mongodb://localhost:27017
DB_NAME=jobcraft_db

# JWT Authentication Config
# Generate a strong key (e.g., using `openssl rand -hex 32` or similar)
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini API Config
GEMINI_API_KEY=your_gemini_api_key_here

# App Environment
# Set to "production" on deployed instances. Anything else (or unset) additionally
# allows http://localhost:5173 and http://127.0.0.1:5173 as CORS origins for local
# development; since the API sends credentials, those must not be allowed in prod.
APP_ENV=development

# Resend & Frontend Config
RESEND_API_KEY=your_resend_api_key_here
FRONTEND_URL=http://localhost:5173

