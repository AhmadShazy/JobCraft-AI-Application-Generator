# ─────────────────────────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
DB_NAME=jobcraft_db

# ─────────────────────────────────────────────────────────────
# JWT Authentication
# Generate a strong secret, e.g. `openssl rand -hex 32`.
# IMPORTANT: in production (APP_ENV=production) the app REFUSES TO START if
# JWT_SECRET is left as the placeholder — set a real one in the deploy env.
# Changing JWT_SECRET invalidates all existing sessions (everyone re-logs-in).
# ─────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# ─────────────────────────────────────────────────────────────
# Cookies
# Defaults suit same-site deployment (frontend + API under one registrable
# domain, reached via the Vercel /api proxy). If the frontend is served from a
# genuinely different site than the API, set COOKIE_SAMESITE=none (which requires
# COOKIE_SECURE=true). Leave COOKIE_SECURE=true in any real deployment.
# ─────────────────────────────────────────────────────────────
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ─────────────────────────────────────────────────────────────
# Gemini API
# GEMINI_MODEL_CHAIN is an optional comma-separated fallback chain override.
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TIMEOUT_SECONDS=60
# GEMINI_MODEL_CHAIN=gemini-2.5-flash,gemini-2.5-flash-lite

# ─────────────────────────────────────────────────────────────
# App Environment
# Set to "production" on deployed instances. Anything else (or unset) additionally
# allows http://localhost:5173 and http://127.0.0.1:5173 as CORS origins for local
# development; since the API sends credentials, those must not be allowed in prod.
# The match is an exact string compare, so only the literal "production" locks it down.
# ─────────────────────────────────────────────────────────────
APP_ENV=development

# ─────────────────────────────────────────────────────────────
# Resend (transactional email) & Frontend
# RESEND_FROM must be an address on a domain you've verified in Resend.
# If RESEND_API_KEY is unset/placeholder, verification & reset links are printed
# to the server log instead of emailed (useful for local dev).
# FRONTEND_URL is also the CORS allowlist in production (comma-separated for several).
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=onboarding@resend.dev
FRONTEND_URL=http://localhost:5173
